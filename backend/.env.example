# MechaGen backend — copy to `.env` or `.env.local` (not committed) and fill secrets.

# Default AI backend is NVIDIA — https://build.nvidia.com
NVIDIA_API_KEY=

# Optional: override NVIDIA integrate base (default https://integrate.api.nvidia.com/v1)
# NVIDIA_BASE_URL=

# Chat model id for NVIDIA integrate /v1/chat/completions
# Must match Build / API catalog (usually nvidia/<model-name>). Wrong id → 404.
MECHAGEN_AI_MODEL=nvidia/nemotron-3-super-120b-a12b

# Which provider runs CadQuery chat: nvidia (default) | featherless | fallback
# - nvidia — https://integrate.api.nvidia.com/v1
# - featherless — https://api.featherless.ai/v1 (OpenAI-compatible)
# - fallback — try NVIDIA first, then Featherless on failure (needs both API keys)
# MECHAGEN_AI_BACKEND=nvidia

# Featherless — only when MECHAGEN_AI_BACKEND=featherless or fallback
FEATHERLESS_API_KEY=
# FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_AI_MODEL=nvidia/NVIDIA-Nemotron-3-Super-120B-A12B-BF16

# Max completion tokens (long CadQuery + JSON parts). Lower (e.g. 8192) if the API rejects high values.
MECHAGEN_AI_MAX_TOKENS=32768

# Optional: single NVIDIA timeout (ms) for all generate calls. If unset: 60s simple, 180s complex/detail.
# MECHAGEN_AI_TIMEOUT_MS=120000

# CadQuery subprocess (ms). If unset: 90s normal, 180s when highDetail.
# MECHAGEN_PYTHON_TIMEOUT_MS=120000

# CadQuery runner env flags (executeGenerate)
# MECHAGEN_HIGH_DETAIL=0
# MECHAGEN_KEEP_FINISH_OPS=0
