# MechaGen Backend — Environment Variables
# Copy this to `.env.local` (or `.env`) and fill in your values.
# `.env.local` takes precedence over `.env`.
# NEVER commit the actual secrets file.

# ─────────────────────────────────────────────────────────────────────────────
# SERVER
# ─────────────────────────────────────────────────────────────────────────────

# Port the API server listens on (default: 3001)
PORT=3001

# Environment mode: development | production
NODE_ENV=development

# ─────────────────────────────────────────────────────────────────────────────
# AI — NVIDIA NIMS (primary)
# Get your key at https://build.nvidia.com
# ─────────────────────────────────────────────────────────────────────────────

NVIDIA_API_KEY=

# Override NVIDIA integrate base (default: https://integrate.api.nvidia.com/v1)
# AI_BASE_URL=https://integrate.api.nvidia.com/v1

# Model ID for generation (must match NVIDIA API catalog)
AI_MODEL=nvidia/llama-3.1-nemotron-ultra-253b-v1

# Max completion tokens (lower to 8192 if API rejects high values)
MECHAGEN_AI_MAX_TOKENS=32768

# Per-call timeout in ms (default: 60s simple, 180s detailed)
# MECHAGEN_AI_TIMEOUT_MS=120000

# ─────────────────────────────────────────────────────────────────────────────
# AI — OPENAI (optional fallback)
# ─────────────────────────────────────────────────────────────────────────────

OPENAI_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# AUTH
# ─────────────────────────────────────────────────────────────────────────────

# Set to true to require X-API-Key header on all requests (default: false = open in dev)
API_KEY_REQUIRED=false

# Comma-separated API keys in format key:userId,key2:userId2
# Example: sk-abc123:user-alice,sk-xyz789:user-bob
API_KEYS=

# Secret key required for admin endpoints (X-API-Key: <ADMIN_KEY>)
ADMIN_KEY=

# Dev fallback userId when API_KEY_REQUIRED=false (default: dev-user)
DEV_USER_ID=dev-user

# Dev fallback plan slug (default: free)
DEV_PLAN=free

# ─────────────────────────────────────────────────────────────────────────────
# WORKER — CadQuery solid generation
# ─────────────────────────────────────────────────────────────────────────────

# URL of the running cadquery_worker.py server (default: http://127.0.0.1:5001)
WORKER_URL=http://127.0.0.1:5001

# Worker call timeout in ms (default: 120000 = 2 minutes)
WORKER_TIMEOUT=120000

# ─────────────────────────────────────────────────────────────────────────────
# RATE LIMITS (per-user, per window)
# ─────────────────────────────────────────────────────────────────────────────

# Max generations per window (default: 5)
RL_GENERATION=5

# Max blueprint uploads per window (default: 10)
RL_BLUEPRINT=10

# Max solid builds per window (default: 3)
RL_SOLID_BUILD=3

# Max export calls per window (default: 20)
RL_EXPORT=20

# Rate limit window in ms (default: 60000 = 1 minute)
RL_WINDOW_MS=60000

# ─────────────────────────────────────────────────────────────────────────────
# ANALYTICS (optional — enable with keys)
# ─────────────────────────────────────────────────────────────────────────────

# PostHog project API key (https://posthog.com)
POSTHOG_API_KEY=

# Segment write key (https://segment.com)
SEGMENT_WRITE_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# STORAGE
# ─────────────────────────────────────────────────────────────────────────────

# Directory for JSON persistence files (default: backend/data/)
# DATA_DIR=./data

# Directory for uploaded blueprint files (default: backend/uploads/)
# UPLOADS_DIR=./uploads
